# Laravel backend the widget talks to (all /api/public/live-chat/* calls).
VITE_BACKEND_URL=http://127.0.0.1:8000

# Reverb websocket server (must match the backend's REVERB_* values).
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Esamco agent dashboard, used only by the local Playwright debug scripts.
FRONTEND_URL=http://localhost:5173
